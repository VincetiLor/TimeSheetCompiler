# Copia in .env.dev e riempi i valori. .env.dev non va committato.

# Obbligatoria: senza, l'app non parte. Ogni ambiente ha la sua, si genera con
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Tra apici singoli: la chiave puo' contenere # e $.
DJANGO_SECRET_KEY=
# True solo in sviluppo. Assente o diverso da True vale False.
DJANGO_DEBUG=False
# Hostname separati da virgola, es. tsc.ing.unimore.it: da qui nascono anche le
# origini CSRF in https. Con DEBUG=True puo' restare vuota: Django accetta gia'
# localhost e 127.0.0.1.
DJANGO_ALLOWED_HOSTS=

# Devono corrispondere ai flag del container tsc-postgres (create_postgres_container.sh).
# DB_PASSWORD e' obbligatoria: senza, l'app non parte.
DB_NAME=timesheet
DB_USER=timesheet
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Shibboleth. UID_IN_DEROGA: uid (separati da virgola) che entrano anche senza
# un ruolo abilitato (faculty/staff/employee), es. uno studente che sviluppa.
UID_IN_DEROGA=
# Solo sviluppo, senza container SP: header finti (richiede DEBUG).
SHIBBOLETH_DEV_MODE=False
SHIBBOLETH_DEV_ID=1
SHIBBOLETH_DEV_NOME=Mario
SHIBBOLETH_DEV_COGNOME=Rossi
SHIBBOLETH_DEV_AFFILIATION=member@unimore.it;staff@unimore.it

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_CONFIDENCE_THRESHOLD=70
OPENAI_TIMEOUT=30

# Hook: somiglianza minima (0-1) tra una keyword e un pezzo del titolo, usata
# solo quando il match esatto non trova niente.
KEYWORD_SIMILARITY_THRESHOLD=0.85

# Selenium (compilazione su Esse3). SELENIUM_BROWSER: firefox o chrome.
# SELENIUM_REMOTE_URL vuota = browser locale; in Docker l'indirizzo del
# container selenium/standalone-*, es. http://selenium:4444. HEADLESS=False
# mostra la finestra del browser (utile in sviluppo).
SELENIUM_BROWSER=firefox
SELENIUM_REMOTE_URL=
SELENIUM_HEADLESS=True
# Solo sviluppo, finché il login è commentato in open_diary: "Compila" apre
# questa pagina salvata invece di Esse3 (percorso relativo al progetto Django).
ESSE3_TEST_PAGE=
# Solo sviluppo: secondi in cui il browser resta aperto a fine compilazione
# (con SELENIUM_HEADLESS=False). 0 in produzione.
SELENIUM_END_PAUSE=0
